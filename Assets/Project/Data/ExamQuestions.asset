%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3bdcd67202acf494e8a0cd248df8e727, type: 3}
  m_Name: ExamQuestions
  m_EditorClassIdentifier: Assembly-CSharp::ExamData
  examTitle: APPLIED NONSENSE 101 - FINAL EXAM
  questions:
  - text: 'In the Thermodynamics of Procrastination, a study session reaches heat death:'
    options:
    - 'After one YouTube video'
    - 'At 11:59 PM'
    - 'At 3:00 AM'
    - 'Never'
    correctIndex: 0
    difficulty: 0
  - text: 'Which pencil grade is legally required for bubble sheets in the Republic of Exams?'
    options:
    - 'HB'
    - '2B'
    - '4H'
    - 'A pen, out of spite'
    correctIndex: 1
    difficulty: 0
  - text: 'Solve for x, where x is the number of times you have checked the clock.'
    options:
    - '3'
    - '12'
    - 'Too many'
    - 'x + 1'
    correctIndex: 3
    difficulty: 0
  - text: 'The Third Law of Group Projects states:'
    options:
    - 'For every action, one person does it'
    - 'Work expands to fill the deadline'
    - 'Energy is never conserved'
    - 'The quiet one knows everything'
    correctIndex: 0
    difficulty: 1
  - text: 'What is the primary export of the Faculty of Arts?'
    options:
    - 'Essays'
    - 'Coffee cups'
    - 'Opinions'
    - 'Tote bags'
    correctIndex: 3
    difficulty: 1
  - text: 'Which of these is NOT a recognised state of matter?'
    options:
    - 'Solid'
    - 'Plasma'
    - 'Soggy'
    - 'Bose-Einstein condensate'
    correctIndex: 2
    difficulty: 1
  - text: 'Convert 450 pounds of jet fuel to kilograms.'
    options:
    - 'About 204 kg'
    - 'About 450 kg'
    - 'About 992 kg'
    - 'Ask the pilot'
    correctIndex: 0
    difficulty: 2
  - text: 'In Reason''s error taxonomy, forgetting a step in a checklist is a:'
    options:
    - 'Slip'
    - 'Lapse'
    - 'Mistake'
    - 'Violation'
    correctIndex: 1
    difficulty: 2
  - text: 'Under exam conditions, the half-life of a memorised answer is:'
    options:
    - 'Until you look up'
    - 'Four seconds'
    - 'One question'
    - 'Longer than you think'
    correctIndex: 0
    difficulty: 2
  - text: 'A bubble sheet shifted down one row after Q3 can cause how many wrong answers out of 10?'
    options:
    - '1'
    - '3'
    - 'Up to 7'
    - '0'
    correctIndex: 2
    difficulty: 3
  - text: 'What is the invigilator thinking about right now?'
    options:
    - 'Lunch'
    - 'You'
    - 'Retirement'
    - 'The heat death of the universe'
    correctIndex: 1
    difficulty: 3
  - text: 'A student checks their sheet twice and changes nothing. They have committed:'
    options:
    - 'A slip'
    - 'A lapse'
    - 'No error at all'
    - 'The only correct act in this room'
    correctIndex: 2
    difficulty: 3
  - text: 'You enter an arrow pattern that is one input wrong. The phone will:'
    options:
    - 'Refuse it'
    - 'Show the right answer anyway'
    - 'Vibrate'
    - 'Show a wrong answer, confidently'
    correctIndex: 3
    difficulty: 4
  - text: 'The invigilator stops walking. This means:'
    options:
    - 'He is tired'
    - 'He is watching someone'
    - 'Nothing at all'
    - 'You have already lost'
    correctIndex: 1
    difficulty: 4
  - text: 'The most dangerous moment in an exam is:'
    options:
    - 'The first question'
    - 'The final minute'
    - 'The moment you feel safe'
    - 'The moment the room empties'
    correctIndex: 2
    difficulty: 4
  easyLength: 4
  mediumLength: 6
  hardLength: 8
  extremeLength: 10
  impossibleLength: 12
